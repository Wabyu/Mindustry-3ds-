# Mindustry 3DS - homebrew application, Old 3DS compatible (64 MB mode).
BasicInfo:
  Title: Mindustry3DS
  ProductCode: CTR-P-MDTY
  Logo: Nintendo
TitleInfo:
  Category: Application
  UniqueId: 0xF4D53
Option:
  UseOnSD: true
  FreeProductCode: true
  MediaFootPadding: false
  EnableCrypt: false
  EnableCompress: false
AccessControlInfo:
  CoreVersion: 2
  DescVersion: 2
  ReleaseKernelMajor: "02"
  ReleaseKernelMinor: "33"
  FileSystemAccess:
    - DirectSdmc
    - DirectSdmcWrite
  MemoryType: Application
  SystemMode: 64MB
  SystemModeExt: Legacy
  CpuSpeed: 268MHz
  EnableL2Cache: false
  IdealProcessor: 0
  AffinityMask: 1
  # makerom adds 32 for applications: 16 becomes 0x30 (48), within 0x18..0x3f.
  Priority: 16
  MaxCpu: 0
  HandleTableSize: 0x200
  DisableDebug: false
  EnableForceDebug: false
  CanWriteSharedPage: true
  CanUsePrivilegedPriority: false
  CanUseNonAlphabetAndNumber: true
  PermitMainFunctionArgument: true
  CanShareDeviceMemory: true
  RunnableOnSleep: false
  SpecialMemoryArrange: false
  MemoryMapping:
    - 1f000000-1f5fffff:r
    # Writable shared DSP buffers used by libctru NDSP.
    - 1ff50000-1ff57fff
    - 1ff70000-1ff77fff
  SystemCallAccess:
    ControlMemory: 1
    QueryMemory: 2
    ExitProcess: 3
    GetProcessIdealProcessor: 6
    CreateThread: 8
    ExitThread: 9
    SleepThread: 10
    GetThreadPriority: 11
    SetThreadPriority: 12
    GetThreadIdealProcessor: 15
    GetCurrentProcessorNumber: 17
    CreateMutex: 19
    ReleaseMutex: 20
    CreateSemaphore: 21
    ReleaseSemaphore: 22
    CreateEvent: 23
    SignalEvent: 24
    ClearEvent: 25
    CreateTimer: 26
    SetTimer: 27
    CancelTimer: 28
    ClearTimer: 29
    CreateMemoryBlock: 30
    MapMemoryBlock: 31
    UnmapMemoryBlock: 32
    CreateAddressArbiter: 33
    ArbitrateAddress: 34
    CloseHandle: 35
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    DuplicateHandle: 39
    GetSystemTick: 40
    GetHandleInfo: 41
    GetSystemInfo: 42
    GetProcessInfo: 43
    GetThreadInfo: 44
    ConnectToPort: 45
    SendSyncRequest: 50
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetThreadId: 55
    Break: 60
    OutputDebugString: 61
  ServiceAccessControl:
    - APT:U
    - dsp::DSP
    - cfg:u
    - fs:USER
    - gsp::Gpu
    - gsp::Lcd
    - hid:USER
    - ptm:u
SystemControlInfo:
  RemasterVersion: 0
  StackSize: 0x40000
  Dependency:
    am: 0x0004013000001502
    dsp: 0x0004013000001a02
    cfg: 0x0004013000001702
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    ptm: 0x0004013000002202
RomFs:
  # assets generated from upstream Mindustry (sprites, maps, bundles)
  RootPath: romfs
